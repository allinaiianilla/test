# 复制为 .env 并填入真实 key（或直接 export 环境变量）

# OpenAI 官方（Responses API 原生）
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=            # 官方可不填

# 智谱开放平台（Chat Completions 协议，走适配层）
# 注册: https://open.bigmodel.cn  glm-4-flash 免费且已实测可用
ZHIPU_API_KEY=你的key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# DeepSeek（Chat Completions 协议）
# 注册: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 本地 vLLM / Ollama（OpenAI 兼容口）
LOCAL_LLM_API_KEY=dummy
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
